{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Student admission and roster record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "rollNo": { "type": "string" },
        "samsRegNo": { "type": "string" },
        "barcode": { "type": "string" },
        "parentName": { "type": "string" },
        "dob": { "type": "string" },
        "maxMarks": { "type": "number" },
        "marksSecured": { "type": "number" },
        "department": { "type": "string" },
        "stream": { "type": "string" },
        "isAedp": { "type": "boolean" },
        "category": { "type": "string" },
        "marksPercentage": { "type": "number" },
        "bloodGroup": { "type": "string" },
        "phone": { "type": "string" },
        "gender": { "type": "string" },
        "status": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "samsRegNo", "department", "stream"]
    },
    "SeatMatrixItem": {
      "title": "SeatMatrixItem",
      "description": "Department intake seat matrix and vacancy status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deptName": { "type": "string" },
        "stream": { "type": "string" },
        "isAedp": { "type": "boolean" },
        "specialization": { "type": "string" },
        "sanctioned": { "type": "number" },
        "admitted": { "type": "number" },
        "vacant": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "deptName", "stream", "sanctioned"]
    },
    "SpotCandidate": {
      "title": "SpotCandidate",
      "description": "Spot round selection and waitlist candidate",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentName": { "type": "string" },
        "samsRegNo": { "type": "string" },
        "deptId": { "type": "string" },
        "deptName": { "type": "string" },
        "stream": { "type": "string" },
        "category": { "type": "string" },
        "marksPercentage": { "type": "number" },
        "waitlistRank": { "type": "number" },
        "reportedStatus": { "type": "string" },
        "selectionStatus": { "type": "string" },
        "appliedAt": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["id", "studentName", "samsRegNo", "deptName"]
    },
    "Notice": {
      "title": "Notice",
      "description": "College notice board announcements",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "deptId": { "type": "string" },
        "date": { "type": "string" },
        "downloadUrl": { "type": "string" },
        "isImportant": { "type": "boolean" },
        "content": { "type": "string" }
      },
      "required": ["id", "title", "category", "date"]
    },
    "FacultyMember": {
      "title": "FacultyMember",
      "description": "Faculty member directory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deptId": { "type": "string" },
        "deptName": { "type": "string" },
        "name": { "type": "string" },
        "designation": { "type": "string" },
        "qualification": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "photoUrl": { "type": "string" },
        "isHod": { "type": "boolean" }
      },
      "required": ["id", "deptName", "name", "designation"]
    },
    "FAQItem": {
      "title": "FAQItem",
      "description": "Frequently asked questions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "answer": { "type": "string" },
        "category": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "question", "answer", "category"]
    },
    "HodAccount": {
      "title": "HodAccount",
      "description": "Department HOD account credentials and info",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deptName": { "type": "string" },
        "username": { "type": "string" },
        "password": { "type": "string" },
        "hodName": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "deptName", "username", "password"]
    },
    "SystemSettings": {
      "title": "SystemSettings",
      "description": "College profile and global configuration settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "spotRoundEnabled": { "type": "boolean" },
        "collegeLogoUrl": { "type": "string" },
        "collegeName": { "type": "string" },
        "collegeCode": { "type": "string" },
        "tagline": { "type": "string" },
        "naacGrade": { "type": "string" },
        "bannerNotice": { "type": "string" },
        "prospectusUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "contactEmail": { "type": "string" },
        "address": { "type": "string" },
        "sheetSyncUrl": { "type": "string" },
        "lastSheetSync": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "collegeName"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System audit trail records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "adminName": { "type": "string" },
        "actionType": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "timestamp", "actionType", "description"]
    }
  },
  "firestore": {
    "students/{studentId}": { "schema": "Student", "description": "Student DB records" },
    "seatMatrix/{deptId}": { "schema": "SeatMatrixItem", "description": "Seat matrix records" },
    "spotCandidates/{candidateId}": { "schema": "SpotCandidate", "description": "Spot candidates" },
    "notices/{noticeId}": { "schema": "Notice", "description": "Notice board entries" },
    "faculty/{facultyId}": { "schema": "FacultyMember", "description": "Faculty directory" },
    "faqs/{faqId}": { "schema": "FAQItem", "description": "College FAQs" },
    "hodAccounts/{deptId}": { "schema": "HodAccount", "description": "HOD credentials and info" },
    "systemSettings/{settingsId}": { "schema": "SystemSettings", "description": "College settings" },
    "auditLogs/{logId}": { "schema": "AuditLog", "description": "Audit trail logs" }
  }
}
