rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read and write access to all public collections for live real-time sync
    match /students/{document=**} {
      allow read, write: if true;
    }

    match /seatMatrix/{document=**} {
      allow read, write: if true;
    }

    match /spotCandidates/{document=**} {
      allow read, write: if true;
    }

    match /notices/{document=**} {
      allow read, write: if true;
    }

    match /faculty/{document=**} {
      allow read, write: if true;
    }

    match /faqs/{document=**} {
      allow read, write: if true;
    }

    match /hodAccounts/{document=**} {
      allow read, write: if true;
    }

    match /systemSettings/{document=**} {
      allow read, write: if true;
    }

    match /auditLogs/{document=**} {
      allow read, write: if true;
    }

    match /subjectCounselling/{document=**} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
